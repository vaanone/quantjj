# =============================================================================
# CSV data source configuration.
#
# The app reads its candlestick CSVs from an Amazon VPS (HTTP) when
# CSV_BASE_URL is set. If CSV_BASE_URL is unset, it falls back to Google
# Drive (GOOGLE_DRIVE_API_KEY) so production keeps working until the VPS
# is configured.
# =============================================================================

# --- Amazon VPS (preferred) ---
# Base URL of the directory that serves the CSV files over HTTP(S).
# Trailing slash optional. Example: https://vps.example.com/csv/
CSV_BASE_URL=

# Optional: explicit comma-separated list of file names. If set, the app
# fetches exactly these files — works with ANY static file host (no
# directory listing needed).
# Example: XAUUSD_PERIOD_M15_3Days_SR.csv,ADANITRANS#_PERIOD_M5_3Days_SR.csv
CSV_FILE_NAMES=

# Optional auth for the VPS (leave blank if the directory is public):
# CSV_AUTH_TOKEN  — sent as `Authorization: Bearer <token>`
# CSV_BASIC_AUTH  — `user:password`, sent as Basic auth
CSV_AUTH_TOKEN=
CSV_BASIC_AUTH=

# --- Google Drive fallback (used only when CSV_BASE_URL is unset) ---
GOOGLE_DRIVE_API_KEY=
